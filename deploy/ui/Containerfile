# Build stage: compile the UI from this checkout
FROM docker.io/library/node:24-alpine AS build
RUN apk add --no-cache git
WORKDIR /src
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY . .
# refresh the translation catalogs first: strings missing from them render as
# message ids in a production build
RUN git config --global --add safe.directory /src && \
    npm run gettext:extract && npm run gettext:compile && \
    npm run build

# Runtime stage: unprivileged nginx serving the UI and proxying to Pulp
FROM docker.io/nginxinc/nginx-unprivileged:stable-alpine
COPY --from=build /src/dist /usr/share/nginx/html/ui
COPY --from=build /src/dist/pulp-ui-config.json /usr/share/nginx/html/pulp-ui-config.json
COPY deploy/ui/default.conf.template /etc/nginx/templates/default.conf.template
# where Pulp's API is reachable from this container; override per deployment
ENV PULP_UPSTREAM=pulp:80
EXPOSE 8080
