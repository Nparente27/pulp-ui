server {
    listen 8080;
    root /usr/share/nginx/html;
    client_max_body_size 0;   # allow large package uploads

    location = / { return 302 /ui/; }

    location = /pulp-ui-config.json { }

    # the UI is a single-page app: unknown paths under /ui/ load index.html
    location /ui/ {
        try_files $uri $uri/ /ui/index.html;
    }

    # Pulp API, content app and the Python package index
    location ~ ^/(pulp|pypi)/ {
        proxy_pass http://${PULP_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
}
